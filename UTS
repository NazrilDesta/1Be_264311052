SOAL 1: Data Definition & Relasi 

1. Tabel pengguna
CREATE TABLE pengguna (
    id_pengguna VARCHAR(10) NOT NULL,
    nama VARCHAR(100) NOT NULL,
    role ENUM('penghuni','admin','tamu') NOT NULL,
    status_aktif ENUM('aktif','nonaktif') NOT NULL DEFAULT 'aktif',
    CONSTRAINT pk_pengguna PRIMARY KEY (id_pengguna)
);

2. Tabel pintu
CREATE TABLE pintu (
    id_pintu VARCHAR(10) NOT NULL,
    status_pintu ENUM('terbuka','terkunci') NOT NULL DEFAULT 'terkunci',
    CONSTRAINT pk_pintu PRIMARY KEY (id_pintu)
);

3. Tabel log_akses
CREATE TABLE log_akses (
    id_akses VARCHAR(10) NOT NULL,
    waktu_akses DATETIME NOT NULL,
    status_akses ENUM('Berhasil','Gagal') NOT NULL,
    status_pintu ENUM('terbuka','terkunci') NOT NULL,
    id_pengguna VARCHAR(10) NOT NULL,
    id_pintu VARCHAR(10) NOT NULL,
    CONSTRAINT pk_log_akses PRIMARY KEY (id_akses),

    CONSTRAINT fk_log_pengguna
        FOREIGN KEY (id_pengguna) REFERENCES pengguna(id_pengguna)
        ON UPDATE CASCADE ON DELETE RESTRICT,

    CONSTRAINT fk_log_pintu
        FOREIGN KEY (id_pintu) REFERENCES pintu(id_pintu)
        ON UPDATE CASCADE ON DELETE RESTRICT
);
